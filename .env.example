# KV Manager - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# CLOUDFLARE CREDENTIALS (Production / Wrangler Secrets)
# ============================================
# ACCOUNT_ID=your_account_id
# API_KEY=your_api_key

# ============================================
# CLOUDFLARE ACCESS (ZERO TRUST)
# ============================================
# Required for production deployments (set via wrangler secret put)
# TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
# POLICY_AUD=your_policy_audience_tag

# Optional: Comma-separated list of additional allowed origins for credentialed CORS
# Same-origin requests are allowed by default in production.
# ALLOWED_ORIGINS=https://kv.your-domain.com,https://admin.your-domain.com

# ============================================
# WORKER API ENDPOINT
# ============================================
# Worker API URL for local development
# Comment out this line for production deployment (uses window.location.origin)
VITE_WORKER_API=http://localhost:8787

# For production:
# Leave VITE_WORKER_API commented out or remove it entirely (recommended - uses same domain as frontend)
# If pointing VITE_WORKER_API to a different origin, add the frontend origin to ALLOWED_ORIGINS.
