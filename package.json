{
  "name": "kv-manager",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "check": "pnpm lint && pnpm typecheck",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy --config wrangler.toml",
    "pages:build": "pnpm build",
    "pages:deploy": "pnpm build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.9",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.26",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-pattern": "^5.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "undici": "^7.29.0",
    "miniflare>undici": "^7.29.0",
    "wrangler>miniflare>undici": "^7.29.0"
  }
